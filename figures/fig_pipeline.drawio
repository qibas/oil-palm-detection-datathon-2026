<mxfile host="app.diagrams.net" agent="sawitguard-make_pipeline_drawio" type="device"><diagram id="sawitguard-pipeline" name="Pipeline"><mxGraphModel dx="1160" dy="716" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="756" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lane1" value='&lt;span style="font-weight: bold; font-size: 13px; color: #008300;"&gt;LAPISAN 1  ·  Dari citra UAV menjadi inventaris tajuk&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;align=left;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="760" height="22" as="geometry" /></mxCell><mxCell id="lane1n" value='&lt;span style="font-style: italic; font-size: 10px; color: #52514e;"&gt;data nyata; label kesehatan tajuk generik, bukan BSR&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;align=right;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="380" y="14" width="740" height="22" as="geometry" /></mxCell><mxCell id="a0" value='&lt;b&gt;Citra UAV RGB nadir&lt;/b&gt;&lt;br&gt;&lt;span style="font-size: 10px; color: #52514e;"&gt;Roboflow ds_B&lt;br&gt;3 ortomosaik · 2.303 ubin 1.024 px&lt;br&gt;GSD ≈ 8,7 cm/px&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#008300;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="260" height="88" as="geometry" /></mxCell><mxCell id="a1" value='&lt;b&gt;Tahap 1 · Deteksi tajuk&lt;/b&gt;&lt;br&gt;&lt;span style="font-size: 10px; color: #52514e;"&gt;YOLO11&lt;br&gt;keluaran: kotak pembatas dan&lt;br&gt;koordinat pusat tajuk&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e7f2e7;strokeColor=#008300;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="50" width="260" height="88" as="geometry" /></mxCell><mxCell id="a2" value='&lt;b&gt;Tahap 2 · Estimasi luas tajuk&lt;/b&gt;&lt;br&gt;&lt;span style="font-size: 10px; color: #52514e;"&gt;Excess Green + ambang Otsu&lt;br&gt;proksi ukuran kanopi,&lt;br&gt;kualitatif, tanpa klaim IoU&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e7f2e7;strokeColor=#008300;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="580" y="50" width="260" height="88" as="geometry" /></mxCell><mxCell id="a3" value='&lt;b&gt;Tahap 3 · Penilaian kesehatan&lt;/b&gt;&lt;br&gt;&lt;span style="font-size: 10px; color: #52514e;"&gt;LightGBM atas statistik RGB&lt;br&gt;keluaran: skor kesehatan&lt;br&gt;per tajuk&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e7f2e7;strokeColor=#008300;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="860" y="50" width="260" height="88" as="geometry" /></mxCell><mxCell id="s1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f1f1ef;strokeColor=#52514e;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=left;spacing=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="158" width="900" height="44" as="geometry" /></mxCell><mxCell id="s1_t" value='&lt;b style="font-size: 12px;"&gt;Evaluasi Lapisan 1&lt;/b&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="32" y="158" width="157" height="44" as="geometry" /></mxCell><mxCell id="s1_b" value='&lt;span style="font-size: 10px; color: #52514e;"&gt;block-CV leave-one-ortho-out, 3 lipatan; pembagian acak dipastikan bocor&lt;br&gt;metrik mAP untuk deteksi, PR-AUC dan ROC-AUC untuk kesehatan; akurasi tidak dilaporkan&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="195" y="158" width="713" height="44" as="geometry" /></mxCell><mxCell id="brg" value='&lt;span style="font-style: italic; font-size: 10px; color: #52514e;"&gt;inventaris tajuk&lt;br&gt;(posisi, ukuran, skor)&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;align=left;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="936" y="158" width="170" height="44" as="geometry" /></mxCell><mxCell id="lane2" value='&lt;span style="font-weight: bold; font-size: 13px; color: #2a78d6;"&gt;LAPISAN 2  ·  Dari inventaris tajuk menjadi peringkat risiko&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;align=left;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="20" y="222" width="760" height="22" as="geometry" /></mxCell><mxCell id="b4" value='&lt;b&gt;Tahap 4 · Rekonstruksi geometri kebun&lt;/b&gt;&lt;br&gt;&lt;span style="font-size: 10px; color: #52514e;"&gt;offset pada nama berkas ubin + pusat kotak pembatas → koordinat global  ·  151.060 kotak anotasi = 5.077 pohon unik  ·  skala dari jarak tetangga 101–106 px terhadap jarak tanam 9 m&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e4edfa;strokeColor=#2a78d6;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="252" width="1100" height="62" as="geometry" /></mxCell><mxCell id="uji" value='&lt;b&gt;Uji antarmuka&lt;/b&gt;&lt;br&gt;&lt;span style="font-size: 10px; color: #52514e;"&gt;dibandingkan, bukan dialirkan&lt;br&gt;derajat 5,62 lawan 5,74, selisih 2%&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#ffffff;strokeColor=#52514e;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="336" width="260" height="62" as="geometry" /></mxCell><mxCell id="ujin" value='&lt;span style="font-style: italic; font-size: 10px; color: #52514e;"&gt;kebun, zaman, dan sistem koordinat kedua sumber berbeda, sehingga keduanya tidak digabungkan&lt;br&gt;5,62 memakai kotak kebenaran-dasar, bukan prediksi YOLO, jadi ia batas atas&lt;br&gt;5,74 dihitung pada pohon bagian dalam saja, karena itu berbeda dari derajat 5,59 graf penuh Tahap 5&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;align=left;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="300" y="336" width="620" height="62" as="geometry" /></mxCell><mxCell id="b0" value='&lt;b&gt;Panel lapangan Eg9PP&lt;/b&gt;&lt;br&gt;&lt;span style="font-size: 10px; color: #52514e;"&gt;1.200 sawit · 14 famili · 2 parcel&lt;br&gt;45 sensus sepanjang 25 tahun&lt;br&gt;Ganoderma terverifikasi; tanpa citra&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="340" height="92" as="geometry" /></mxCell><mxCell id="b5" value='&lt;b&gt;Tahap 5 · Graf kedekatan dan peramalan&lt;/b&gt;&lt;br&gt;&lt;span style="font-size: 10px; color: #52514e;"&gt;r = 1,5 × jarak tanam&lt;br&gt;3.354 sisi · derajat rata-rata 5,59&lt;br&gt;MLP · STGNN · STGNN+SI(D)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e4edfa;strokeColor=#2a78d6;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="340" height="92" as="geometry" /></mxCell><mxCell id="b6" value='&lt;b&gt;Tahap 6 · Peringkat risiko&lt;/b&gt;&lt;br&gt;&lt;span style="font-size: 10px; color: #52514e;"&gt;AUC-PR pada horizon h = 1…4&lt;br&gt;kalibrasi skor ke persentase&lt;br&gt;belum dikerjakan&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e4edfa;strokeColor=#2a78d6;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="420" width="340" height="92" as="geometry" /></mxCell><mxCell id="outn" value='&lt;span style="font-style: italic; font-size: 10px; color: #52514e;"&gt;Keluaran yang dituju bagi tim kebun.&lt;br&gt;Keduanya belum dihasilkan: keluaran model saat ini masih berupa peringkat,&lt;br&gt;dan kalibrasi skor menjadi persentase belum dikerjakan.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;align=left;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="20" y="546" width="510" height="84" as="geometry" /></mxCell><mxCell id="out1" value='&lt;b&gt;Daftar intervensi berperingkat&lt;/b&gt;&lt;br&gt;&lt;span style="font-size: 10px; color: #52514e;"&gt;ID pohon · koordinat · skor risiko&lt;br&gt;top-k pohon pada anggaran tetap&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#ffffff;strokeColor=#52514e;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="546" width="270" height="84" as="geometry" /></mxCell><mxCell id="out2" value='&lt;b&gt;Peta risiko tingkat blok&lt;/b&gt;&lt;br&gt;&lt;span style="font-size: 10px; color: #52514e;"&gt;risiko ditumpangkan pada kisi tanam&lt;br&gt;mengarahkan sensus lapangan berikutnya&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#ffffff;strokeColor=#52514e;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="546" width="270" height="84" as="geometry" /></mxCell><mxCell id="s2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f1f1ef;strokeColor=#52514e;strokeWidth=1.4;fontSize=12;fontColor=#0b0b0b;verticalAlign=middle;align=left;spacing=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="648" width="1100" height="50" as="geometry" /></mxCell><mxCell id="s2_t" value='&lt;b style="font-size: 12px;"&gt;Ablasi dan evaluasi Lapisan 2&lt;/b&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="32" y="648" width="232" height="50" as="geometry" /></mxCell><mxCell id="s2_b" value='&lt;span style="font-size: 10px; color: #52514e;"&gt;tukar tampilan graf: asli / acak / acak-lokal / tanpa-graf  →  dekomposisi temporal | prevalensi | struktur&lt;br&gt;leave-one-parcel-out, 2 lipatan  ·  20 seed × 2 lipatan = 40 pasangan  ·  selisih di dalam 1 simpangan baku dinyatakan tidak konklusif&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="270" y="648" width="838" height="50" as="geometry" /></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#008300;strokeWidth=1.4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#008300;strokeWidth=1.4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#008300;strokeWidth=1.4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#008300;strokeWidth=1.4;exitX=0.8462;exitY=1.0;exitDx=0;exitDy=0;entryX=0.9636;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#52514e;strokeWidth=1.4;startArrow=blockThin;startFill=1;dashed=1;dashPattern=6 4;exitX=0.1182;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="uji"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#52514e;strokeWidth=1.4;startArrow=blockThin;startFill=1;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.3824;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uji" target="b0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#2a78d6;strokeWidth=1.4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b0" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#2a78d6;strokeWidth=1.4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#2a78d6;strokeWidth=1.4;dashed=1;dashPattern=6 4;exitX=0.6029;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="out2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#2a78d6;strokeWidth=1.4;dashed=1;dashPattern=6 4;exitX=0.1471;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="out1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="530" /><mxPoint x="695" y="530" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>